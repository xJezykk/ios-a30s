diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..bc851f9 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1831,22 +1831,27 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
  * Use the otherwise empty 32MB block above low globals and below gVirtBase
  * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
  */
-#define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#define SWEET_EARLY_FB_VA (LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE)
+#define SWEET_EARLY_FB_PA   0xEC000000ULL
+#define SWEET_EARLY_FB_SIZE 0x01400000ULL
+#define SWEET_EARLY_FB_ENTS ((SWEET_EARLY_FB_SIZE + ARM_TT_L2_SIZE - 1) / ARM_TT_L2_SIZE)
 
 static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	assert(va + SWEET_EARLY_FB_ENTS * ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (unsigned int i = 0; i < SWEET_EARLY_FB_ENTS; i++) {
+		assert(slot[i] == ARM_TTE_EMPTY);
+		slot[i] = (SWEET_EARLY_FB_PA + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 374a679..4d0bcec 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -514,11 +514,12 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	/* Stage 0: white 64x8 band, no stack or page tables needed. */
+	/* (a30s patch 0085) A30s fb: 0xEC000000, 720x1560, stride 2880 */
+	MOV64	x0, (0xEC000000 + 1548 * 2880)
 	mov		w1, #-1
-	mov		x2, #32
-	mov		x4, #4320
+	mov		x2, #8
+	mov		x4, #2880
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -695,14 +696,14 @@ Lkernelcache_base_found:
 	 * so adding the block size to the TTE value steps the PA field
 	 * without touching them.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, 0xEC000000			/* a30s patch 0085: SBOOT fb (was Redmi 0x9c000000) */
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	add		x13, x13, x12, lsl #TTE_SHIFT
 	orr		x11, x11, x10
-	MOV64	x12, (0x02000000 >> ARM_TT_L2_SHIFT)
+	MOV64	x12, ((0x01400000 + (1 << ARM_TT_L2_SHIFT) - 1) >> ARM_TT_L2_SHIFT)	/* 20MB fb reserve, rounded up to L2 blocks */
 	MOV64	x14, (1 << ARM_TT_L2_SHIFT)
 Lsweet_splash_r:
 	str		x11, [x13], #8
