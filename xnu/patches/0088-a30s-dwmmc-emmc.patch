+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+emmc_map_controller(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+
+	if (se.regs != 0) {
+		return 0;
+	}
+	if (SecureDTLookupEntry(NULL, "/arm-io/dwmmc0", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t) || reg[1] < EMMC_REG_SIZE ||
+	    reg[0] > UINT32_MAX - EMMC_SOC_BASE) {
+		printf("SWEET eMMC: missing or invalid /arm-io/dwmmc0 reg\n");
+		return ENXIO;
+	}
+	se.regs = ml_io_map((vm_offset_t)(EMMC_SOC_BASE + reg[0]),
+	    (vm_size_t)reg[1]);
+	return se.regs == 0 ? ENXIO : 0;
+}
+
+static int
+sweet_emmc_init(void)
+{
+	char partition[64] = "userdata";
+	uint32_t rw = 0;
+	int error = emmc_map_controller();
+
+	if (error != 0) {
+		return error;
+	}
+	PE_parse_boot_argn("emmcroot", partition, sizeof(partition));
+	PE_parse_boot_argn("emmcw", &rw, sizeof(rw));
+	if (emmc_rd(REG_VERID) != 0x5342270au ||
+	    emmc_rd(REG_HCON) != 0x08e42541u ||
+	    ((emmc_rd(REG_CLKSEL) >> 24) & 7u) != 3u ||
+	    !(emmc_rd(REG_PWREN) & 1u) || !(emmc_rd(REG_CLKENA) & 1u)) {
+		printf("SWEET eMMC: unexpected controller handoff (ver=%08x hcon=%08x clksel=%08x)\n",
+		    emmc_rd(REG_VERID), emmc_rd(REG_HCON), emmc_rd(REG_CLKSEL));
+		return ENXIO;
+	}
+	if (emmc_rd(REG_CTRL) & (CTRL_DMA_ENABLE | CTRL_USE_IDMAC)) {
+		printf("SWEET eMMC: refusing host with DMA active (ctrl=%08x)\n",
+		    emmc_rd(REG_CTRL));
+		return ENXIO;
+	}
+	emmc_wr(REG_INTMASK, 0);
+	emmc_wr(REG_CTRL, emmc_rd(REG_CTRL) & ~CTRL_INT_ENABLE);
+	se.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&sweet_emmc_lock);
+	error = emmc_initialize_card();
+	if (!error) {
+		error = emmc_find_partition(partition);
+	}
+	lck_mtx_unlock(&sweet_emmc_lock);
+	if (error) {
+		printf("SWEET eMMC: initialization failed: %d\n", error);
+		return error;
+	}
+	se.bmajor = bdevsw_add(-1, &sweet_emmc_bdevsw);
+	if (se.bmajor < 0) {
+		return ENXIO;
+	}
+	se.cmajor = cdevsw_add_with_bdev(-1, &sweet_emmc_cdevsw, se.bmajor);
+	if (se.cmajor < 0) {
+		return ENXIO;
+	}
+	se.bdev = makedev(se.bmajor, 0);
+	devfs_make_node(se.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640,
+	    "emmcroot0");
+	devfs_make_node(makedev(se.cmajor, 0), DEVFS_CHAR, UID_ROOT,
+	    GID_OPERATOR, 0640, "remmcroot0");
+	/* Enable writes only after the selected partition has been bounded. */
+	se.writable = (rw == 1);
+	se.ready = true;
+	printf("SWEET eMMC: \"%s\": LBA 0x%llx, %llu MiB, %s, 8-bit PIO\n",
+	    partition, se.first_sector,
+	    se.partition_sectors * EMMC_BLOCK_SIZE >> 20,
+	    se.writable ? "read-write" : "read-only");
+	return 0;
+}
+
+int
+sweet_emmc_rootdev(dev_t *dev)
+{
+	if (!se.ready) {
+		int error = sweet_emmc_init();
+		if (error != 0) {
+			return error;
+		}
+	}
+	*dev = se.bdev;
+	return 0;
+}
