diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 596b9e0..96d60fd 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -61,7 +61,7 @@ MACHINE_FLAGS_ARM64_T8103 = -DARM64_BOARD_CONFIG_T8103                  -mcpu=ap
 MACHINE_FLAGS_ARM64_T6000 = -DARM64_BOARD_CONFIG_T6000 		-mcpu=apple-a14
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -march=armv8.2-a+crypto
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET
 
 
 #
@@ -351,6 +351,19 @@ ifeq ($(CURRENT_MACHINE_CONFIG),SWEET)
 #
 ARM64_PLKSEG_ADDR  =0xfffffff004004000
 ARM64_LINK_ADDR    =0xfffffff007004000
+#
+# (a30s patch 0084) Do NOT use ARM_LARGE_MEMORY with 4K pages. That layout puts
+# VM_MIN_KERNEL_ADDRESS / LOW_GLOBAL_BASE_ADDRESS at -2TB and the physical
+# aperture below it, which needs a >39-bit TTBR1; the 4K pmap is L1-rooted
+# (T1SZ_BOOT 25 = top 512GB only), so those VAs are unmapped. The non-large
+# layout (BCM2837-style: kernel VA at -128GB..-16GB, low globals at -64GB)
+# fits the window, and the link bases above already sit in it. The small
+# bootstrap pool is enough: DRAM handed to XNU is only 0x31300000 bytes.
+# MACH_VM_MAX_ADDRESS: pmap.c's 4K static_assert needs the commpage nesting
+# block at/above it, so use the non-macOS limit (0xFC0000000).
+#
+# Append the baseline ISA here because CFLAGS_ARM64 expands this after -arch.
+LARGE_MEMORY_DEFINE=-UARM_LARGE_MEMORY -DSWEET_4K_USERVA=1 -march=armv8-a+crypto
 endif
 endif

diff --git a/osfmk/arm/commpage/commpage_asm.s b/osfmk/arm/commpage/commpage_asm.s
index 0000000..0000000 100644
--- a/osfmk/arm/commpage/commpage_asm.s
+++ b/osfmk/arm/commpage/commpage_asm.s
@@ -272,7 +272,16 @@ _pfz_trylock_and_enqueue:
 	mov		w11, #1			 // locked value = w11 = 1
 
 	// Try to grab the lock
-	casa	w10, w11, [x3]	 // Atomic CAS with acquire barrier
+	// ARMv8.0 acquire CAS: retry only on a lost exclusive store.
+Ltrylock_enqueue_cas:
+	ldaxr	w10, [x3]
+	cbnz	w10, Ltrylock_enqueue_cas_failed
+	stxr	w12, w11, [x3]
+	cbnz	w12, Ltrylock_enqueue_cas
+	b	Ltrylock_enqueue_cas_done
+Ltrylock_enqueue_cas_failed:
+	clrex
+Ltrylock_enqueue_cas_done:
 	cbz		w10, Ltrylock_enqueue_success
 
 	mov		x0, #-1			// Failed
@@ -323,6 +332,15 @@ _pfz_trylock_and_dequeue:
 	// Try to grab the lock
 	mov		w10, wzr		 // unlock value = w10 = 0
 	mov		w11, #1			 // locked value = w11 = 1
 
-	casa	w10, w11, [x2]	 // Atomic CAS with acquire barrier
+	// ARMv8.0 acquire CAS: retry only on a lost exclusive store.
+Ltrylock_dequeue_cas:
+	ldaxr	w10, [x2]
+	cbnz	w10, Ltrylock_dequeue_cas_failed
+	stxr	w12, w11, [x2]
+	cbnz	w12, Ltrylock_dequeue_cas
+	b	Ltrylock_dequeue_cas_done
+Ltrylock_dequeue_cas_failed:
+	clrex
+Ltrylock_dequeue_cas_done:
 	cbz		w10, Ltrylock_dequeue_success
 
 	mov		x0, #-1			// Failed
 
