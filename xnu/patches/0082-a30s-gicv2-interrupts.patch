diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..cc1c3d3 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -80,4 +80,40 @@
 #define ICC_SRE_SRE                             0x1
 /* End of GICv3 register definitions */
 
+/*
+ * Exynos 7904 (Galaxy A30s) variation inside the SWEET machine config:
+ * the SoC has a GIC-400 (GICv2, memory-mapped GICC) instead of the
+ * GICv3 system-register based controller of the reference phone. When
+ * SWEET_GICV2 is defined, every ICC_* system register access is
+ * replaced by the pe_fiq/sleh GICv2 branches (see patch 0078).
+ */
+#define SWEET_GICV2                             1
+
+/*
+ * HAS_GIC_V3 is the Apple phone default above (GIC-600); the A30s GIC-400
+ * build must switch it off so pe_fiq compiles the memory-mapped GICC
+ * controller arm instead of the ICC_-register GICv3 arm. SWEET.h is the
+ * only place that defines HAS_GIC_V3, so the flip is one-sided.
+ */
+#if HAS_GIC_V3
+#undef HAS_GIC_V3
+#define HAS_GIC_V3                              0
+#endif
+
+/* GICv2 register offsets (ARM IHI 0022, GIC-400 TRM) */
+#define GICC_CTLR                               0x00
+#define GICC_CTLR_ENABLE                        0x1 /* Group 1 enable, NS view */
+#define GICC_PMR                                0x04
+#define GICC_BPR                                0x08
+#define GICC_IAR                                0x0C
+#define GICC_IAR_INTID_MASK                     0x3FF
+#define GICC_EOIR                               0x10
+
+#define GICD_IGROUPR                            0x080
+#define GICD_ISENABLER                          0x100
+#define GICD_IPRIORITYR                         0x400
+#define GICD_SGIR                               0xF00
+/* TargetListFilter = 0b10: interrupt the requesting CPU interface only */
+#define GICD_SGIR_FILTER_SELF                   (2U << 8)
+
 #endif /* ! _PEXPERT_ARM64_SWEET_H */
