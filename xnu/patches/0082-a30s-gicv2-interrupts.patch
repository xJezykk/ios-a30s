diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..6bb07db 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -13,15 +13,17 @@
 #include <pexpert/arm64/board_config.h>
 
 
-#if HAS_GIC_V3
-#define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
-MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
-
 #if defined(SWEET)
-/* Phone default; QEMU virt wires the architected virtual timer to INTID 27. */
+/* Phone default; QEMU virt wires the architected virtual timer to INTID 27.
+ * Declared before the HAS_GIC_V3 fork: the GICv2 (A30s) arm re-reads
+ * /arm-io/gic "virtual-timer-intid" and writes the same global. */
 SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
 #endif
 
+#if HAS_GIC_V3
+#define GICR_WAKE_TIMEOUT_NS (1000000000ULL) // timeout for redistributor wakeup (default 1s)
+MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS, MACHINE_TIMEOUT_UNIT_NSEC, NULL);
+
 static vm_offset_t gicd_base;
 static vm_offset_t gicr_base;
 static vm_offset_t gicr_size;
@@ -222,9 +224,148 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#else /* !HAS_GIC_V3 */
+#if defined(SWEET_GICV2)
+/*
+ * Exynos 7904: GIC-400 (GICv2). No redistributors, no ICC system
+ * registers; the CPU interface is memory-mapped GICC. The ADT reg
+ * property of /arm-io/gic is {gicc_base, gicc_size, gicd_base,
+ * gicd_size}.
+ */
+static vm_offset_t gicc_base;
+static vm_offset_t gicd_base;
+
+static uint32_t
+sweet_gicc_read32(uint32_t offset)
+{
+	return *((volatile uint32_t *) (gicc_base + offset));
+}
+
+static void
+sweet_gicc_write32(uint32_t offset, uint32_t value)
+{
+	*((volatile uint32_t *) (gicc_base + offset)) = value;
+}
+
+static uint32_t
+sweet_gicd_read32(uint32_t offset)
+{
+	return *((volatile uint32_t *) (gicd_base + offset));
+}
+
+static void
+sweet_gicd_write32(uint32_t offset, uint32_t value)
+{
+	*((volatile uint32_t *) (gicd_base + offset)) = value;
+}
+
+uint32_t
+pe_sweet_gic_iar(void)
+{
+	return sweet_gicc_read32(GICC_IAR);
+}
+
+void
+pe_sweet_gic_eoi(uint32_t iar)
+{
+	sweet_gicc_write32(GICC_EOIR, iar);
+}
+
+/*
+ * TargetListFilter = 0b10 (self only) raises the SGI on the requesting
+ * interface without needing its interface number.
+ */
+void
+pe_sweet_gic_self_sgi(uint32_t intid)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	sweet_gicd_write32(GICD_SGIR,
+	    GICD_SGIR_FILTER_SELF | (intid & 0xF));
+	__builtin_arm_isb(ISB_SY);
+}
+
+void
+pe_init_fiq()
+{
+	/*
+	 * gicd_base is 0x0 only before it's initialized by the boot
+	 * processor; SecureDT routines are not thread-safe.
+	 */
+	if (!gicd_base) {
+		int error;
+		DTEntry entry;
+		void const *prop;
+		unsigned int prop_size;
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+		gicc_base = ml_io_map(soc_base_phys + ((uint64_t const *)prop)[0],
+		    ((uint64_t const *)prop)[1]);
+		gicd_base = ml_io_map(soc_base_phys + ((uint64_t const *)prop)[2],
+		    ((uint64_t const *)prop)[3]);
+		if (!gicc_base || !gicd_base) {
+			panic("%s: cannot map GICC/GICD regions", __func__);
+		}
+
+		/*
+		 * Boot CPU only, before RO-late lockdown: the vtimer PPI
+		 * INTID comes from the same ADT property as on the v3 path.
+		 */
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+		kprintf("SWEET GIC v2: gicc %p gicd %p vtimer INTID %u\n",
+		    (void *)gicc_base, (void *)gicd_base, sweet_vtimer_intid);
+	}
+
+	/*
+	 * SGI/PPI registers are banked per security state (NS view here)
+	 * and configured on every call; SPI-side writes are idempotent.
+	 * Everything XNU owns is Group 1 (non-secure), mirroring the
+	 * TrustZone split of the v3 branch.
+	 */
+	sweet_gicc_write32(GICC_PMR, 0xFF);
+	sweet_gicc_write32(GICC_BPR, 0);
+	sweet_gicc_write32(GICC_CTLR, GICC_CTLR_ENABLE);
+
+	for (unsigned int n = 0; n < 16; n++) {
+		sweet_gicd_write32(GICD_IGROUPR + 4 * n, 0xFFFFFFFF);
+	}
+	for (unsigned int i = 0; i < 128; i += 4) {
+		sweet_gicd_write32(GICD_IPRIORITYR + i, 0xA0A0A0A0);
+	}
+	sweet_gicd_write32(GICD_ISENABLER,
+	    (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+	sweet_gicd_write32(GICD_CTLR,
+	    sweet_gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
 {
 }
-#endif
+#endif /* SWEET_GICV2 */
+#endif /* !HAS_GIC_V3 */
